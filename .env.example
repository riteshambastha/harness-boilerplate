# Copy to .env and fill in. Never commit .env.

# Which provider and model the harness uses: anthropic | openai
HARNESS_PROVIDER=anthropic
HARNESS_MODEL=claude-sonnet-5-5
# HARNESS_PROVIDER=openai
# HARNESS_MODEL=gpt-5-mini

# Only the key for the provider you use is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
